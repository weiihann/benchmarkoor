{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workload.schema.json",
  "title": "Prague compute workload package (protocol v1)",
  "description": "Workload file exported by the execution-specs generator. Case ids preserve the originating EEST fixture identity. Canonical naming: the 0x20 hashing operation is KECCAK256, never SHA3. For precompile cases, parameters.precompile_address carries the addressed precompile and workers count actual invocations of that address under the semantic opcode_counts key PRECOMPILE_<address>; target_count is that semantic count, never an aggregate STATICCALL total. The Go validator in pkg/compute/protocol.go additionally enforces unique case ids and receipt-count agreement with transactions, which this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fork", "generator", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "fork": { "const": "Prague" },
    "generator": { "$ref": "#/$defs/generator" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "seed"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "target_operation": {
          "type": "string",
          "minLength": 1,
          "not": { "const": "SHA3" },
          "description": "Canonical operation name; the 0x20 hashing operation is KECCAK256."
        },
        "parameters": {
          "type": ["object", "null"],
          "description": "Free-form case parameters. Precompile cases conventionally carry precompile_address (0x-prefixed 20-byte hex)."
        },
        "status": { "enum": ["ready", "unsupported"] },
        "reason": { "type": "string", "minLength": 1 },
        "pre": {
          "type": ["object", "null"],
          "additionalProperties": { "$ref": "#/$defs/account" },
          "propertyNames": { "pattern": "^0x[0-9a-fA-F]{40}$" }
        },
        "transactions": {
          "type": ["array", "null"],
          "items": { "$ref": "#/$defs/transaction" }
        },
        "expected": { "$ref": "#/$defs/expected" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "unsupported" } },
            "required": ["status"]
          },
          "then": { "required": ["reason"] }
        },
        {
          "if": {
            "properties": { "status": { "const": "ready" } },
            "required": ["status"]
          },
          "then": {
            "required": ["id", "family", "target_operation", "parameters", "pre", "transactions", "expected"],
            "properties": {
              "parameters": { "type": "object" },
              "pre": { "type": "object" },
              "transactions": { "type": "array", "minItems": 1 },
              "reason": { "maxLength": 0 }
            }
          }
        }
      ]
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["balance", "nonce", "storage"],
      "properties": {
        "balance": { "$ref": "#/$defs/hexQuantity" },
        "nonce": { "$ref": "#/$defs/hexQuantity" },
        "code": { "$ref": "#/$defs/hexByteString" },
        "storage": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/hexByteString" },
          "propertyNames": { "$ref": "#/$defs/hexByteString" }
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sender", "secret_key", "to", "data", "value", "gas_limit"],
      "properties": {
        "sender": { "$ref": "#/$defs/address" },
        "secret_key": { "$ref": "#/$defs/word32" },
        "to": { "$ref": "#/$defs/address" },
        "data": { "$ref": "#/$defs/hexByteString" },
        "value": { "$ref": "#/$defs/hexQuantity" },
        "gas_limit": { "type": "integer", "minimum": 1 }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipts"],
      "properties": {
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["success"],
            "properties": {
              "success": { "type": "boolean" },
              "logs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["address", "topics", "data"],
                  "properties": {
                    "address": { "$ref": "#/$defs/address" },
                    "topics": { "type": "array", "items": { "$ref": "#/$defs/word32" } },
                    "data": { "$ref": "#/$defs/hexByteString" }
                  }
                }
              }
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/hexByteString" },
            "propertyNames": { "$ref": "#/$defs/hexByteString" }
          },
          "propertyNames": { "pattern": "^0x[0-9a-fA-F]{40}$" }
        }
      }
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "word32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "hexByteString": {
      "type": "string",
      "pattern": "^0x(?:[0-9a-fA-F]{2})*$",
      "description": "0x-prefixed whole-byte hex; 0x is the empty byte string. EEST 32-byte padding is allowed but not required."
    },
    "hexQuantity": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]+$",
      "description": "Hex quantity with at least one digit; leading zeros allowed because EEST pads values."
    }
  }
}
