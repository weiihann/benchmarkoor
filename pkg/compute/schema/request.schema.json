{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request.schema.json",
  "title": "NewL1 compute worker request (protocol v2)",
  "description": "Request passed to newl1-bench. A fresh worker process runs one session and flushes one terminal JSONL record per sample. Diagnostic samples run with an inspector; pilot, warmup, and qualification samples run without one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workload_path", "session_id", "mode", "samples"],
  "properties": {
    "schema_version": { "const": 2 },
    "workload_path": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["diagnostic", "performance"] },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sample_id", "case_id", "repetition", "phase"],
        "properties": {
          "sample_id": { "type": "string", "minLength": 1 },
          "case_id": { "type": "string", "minLength": 1 },
          "repetition": { "type": "integer", "minimum": 0 },
          "phase": { "enum": ["diagnostic", "pilot", "warmup", "qualification"] }
        }
      }
    }
  }
}
