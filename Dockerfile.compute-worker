# syntax=docker/dockerfile:1.7
#
# Build with the evm2 checkout as the source context:
#   docker build -f ../benchmarkoor/Dockerfile.compute-worker \
#     -t benchmarkoor-compute-worker:local .
# The checkout must include crates/cli/src/compute and Cargo.lock.

ARG RUST_IMAGE=rust:1.96.0-bookworm
FROM ${RUST_IMAGE} AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        clang \
        cmake \
        libclang-dev \
        m4 \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*
ENV CC=clang

WORKDIR /src/evm2
COPY . .
RUN cargo build --locked --release --package evm2-cli --bin evm2-bench

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/evm2/target/release/evm2-bench /usr/local/bin/evm2-bench
ENTRYPOINT ["evm2-bench"]
