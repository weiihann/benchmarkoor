# syntax=docker/dockerfile:1.7
#
# Use NewL1 as the source context without changing its production image's
# binary-only .dockerignore; this recipe has its own source-only ignore file.
#   docker build -f Dockerfile.compute-worker \
#     -t benchmarkoor-compute-worker:local ../bnbchain-newL1
# The supplied checkout must contain bin/newl1-bench and its Cargo.lock.

ARG RUST_IMAGE=rust:1.93.0-bookworm
FROM ${RUST_IMAGE} AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        clang \
        cmake \
        libclang-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*
ENV CC=clang

WORKDIR /src/newl1
COPY . .
RUN cargo build --locked --release --package newl1-bench

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/newl1/target/release/newl1-bench /usr/local/bin/newl1-bench
ENTRYPOINT ["newl1-bench"]
