# syntax=docker/dockerfile:1.7
#
# Builds the in-tree evm-gasfit analyzer (analyzer/):
#   docker build -f Dockerfile.compute-analyzer -t benchmarkoor-compute-analyzer:local .
# uv.lock is required so analysis dependencies are not resolved from an
# unpinned latest release.

ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.10.4
FROM ${UV_IMAGE} AS uv
FROM python:3.12-slim-bookworm AS build
COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /src/evm-gasfit
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
COPY analyzer/pyproject.toml analyzer/uv.lock analyzer/README.md ./
COPY analyzer/src/ ./src/
RUN uv sync --locked --no-dev --no-editable --python /usr/local/bin/python3.12

FROM python:3.12-slim-bookworm
WORKDIR /campaign
COPY --from=build /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
ENTRYPOINT ["evm-gasfit"]
