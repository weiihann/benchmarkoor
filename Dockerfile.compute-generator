# syntax=docker/dockerfile:1.7
#
# Build with the exact execution-specs checkout selected for the campaign:
#   docker build --build-context execution-specs=../execution-specs \
#     -f Dockerfile.compute-generator -t benchmarkoor-compute-generator:local .
# The checkout's uv.lock is the dependency-resolution authority. The image
# carries no copied generator implementation from benchmarkoor.

ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.10.4
FROM ${UV_IMAGE} AS uv
FROM python:3.12-slim-bookworm AS build
COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /eest
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
COPY --from=execution-specs pyproject.toml uv.lock README.md LICENSE.md ./
COPY --from=execution-specs src/ ./src/
COPY --from=execution-specs packages/ ./packages/
COPY --from=execution-specs tests/ ./tests/
RUN uv sync --locked --no-dev --no-editable --python /usr/local/bin/python3.12 \
    --package ethereum-execution-testing

FROM python:3.12-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /eest
COPY --from=build /eest /eest
COPY --from=build /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
ENTRYPOINT ["fill"]
